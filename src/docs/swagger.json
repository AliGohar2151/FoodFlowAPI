{
  "openapi": "3.0.3",
  "info": {
    "title": "FoodFlow API",
    "version": "1.0.0",
    "description": "Production-grade multi-vendor food delivery API engine built with Express.js, TypeScript, PostgreSQL (Prisma), Redis, and Zod."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": { "type": "object" },
          "message": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "BAD_REQUEST" },
              "message": { "type": "string", "example": "Invalid input parameters" },
              "details": { "type": "object" }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check status",
        "tags": ["Health"],
        "security": [],
        "responses": {
          "200": { "description": "System health metrics and status" }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register a new user account",
        "tags": ["Authentication"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "firstName", "lastName"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 8 },
                  "firstName": { "type": "string" },
                  "lastName": { "type": "string" },
                  "phone": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created successfully" },
          "400": { "description": "Validation error" },
          "409": { "description": "Email already exists" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate user credentials and issue tokens",
        "tags": ["Authentication"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Tokens issued successfully" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get authenticated user profile and roles",
        "tags": ["Authentication"],
        "responses": {
          "200": { "description": "Current user profile" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/restaurants": {
      "get": {
        "summary": "List and filter active restaurants",
        "tags": ["Restaurants"],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 20 }
          },
          { "name": "cuisine", "in": "query", "schema": { "type": "string" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Paginated restaurant catalog" }
        }
      },
      "post": {
        "summary": "Register a new restaurant (Owner)",
        "tags": ["Restaurants"],
        "responses": {
          "201": { "description": "Restaurant created pending approval" }
        }
      }
    },
    "/menus/restaurant/{restaurantId}": {
      "get": {
        "summary": "Get full menu for a restaurant",
        "tags": ["Menus"],
        "parameters": [
          {
            "name": "restaurantId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Restaurant menu with categories and items" }
        }
      }
    },
    "/carts/mine": {
      "get": {
        "summary": "Get customer active shopping cart",
        "tags": ["Cart"],
        "responses": {
          "200": { "description": "Customer active cart details" }
        }
      }
    },
    "/orders": {
      "post": {
        "summary": "Checkout cart and create new order",
        "tags": ["Orders"],
        "responses": {
          "201": { "description": "Order created successfully" }
        }
      },
      "get": {
        "summary": "List customer order history",
        "tags": ["Orders"],
        "responses": {
          "200": { "description": "Paginated order list" }
        }
      }
    },
    "/payments/process": {
      "post": {
        "summary": "Process payment for order",
        "tags": ["Payments"],
        "responses": {
          "200": { "description": "Payment transaction processed" }
        }
      }
    },
    "/deliveries": {
      "get": {
        "summary": "List available delivery tasks for rider",
        "tags": ["Deliveries"],
        "responses": {
          "200": { "description": "Available delivery tasks" }
        }
      }
    },
    "/reviews": {
      "post": {
        "summary": "Submit review for completed order",
        "tags": ["Reviews"],
        "responses": {
          "201": { "description": "Review created" }
        }
      }
    },
    "/coupons/validate": {
      "post": {
        "summary": "Validate coupon code and calculate discount",
        "tags": ["Coupons"],
        "responses": {
          "200": { "description": "Calculated discount details" }
        }
      }
    },
    "/notifications": {
      "get": {
        "summary": "Get customer in-app notifications",
        "tags": ["Notifications"],
        "responses": {
          "200": { "description": "Notification history" }
        }
      }
    },
    "/jobs/stats": {
      "get": {
        "summary": "Get background worker queue metrics (Admin)",
        "tags": ["Background Jobs"],
        "responses": {
          "200": { "description": "Worker queue statistics" }
        }
      }
    },
    "/audit-logs": {
      "get": {
        "summary": "Query audit log records (Admin)",
        "tags": ["Audit Logs"],
        "responses": {
          "200": { "description": "Audit trail history" }
        }
      }
    },
    "/caching/health": {
      "get": {
        "summary": "Get Redis cache health status (Admin)",
        "tags": ["Caching"],
        "responses": {
          "200": { "description": "Cache health status" }
        }
      }
    }
  }
}

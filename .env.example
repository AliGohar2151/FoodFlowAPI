# ── Environment Variables ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodflow_dev

# Docker Compose overrides (used by docker-compose.yml variable substitution)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=foodflow_dev
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: Change both secrets to long random strings in production.
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change-this-to-a-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=change-this-to-another-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── Security ─────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3001
BCRYPT_ROUNDS=12

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@foodflow.com
